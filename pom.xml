<?xml version="1.0" encoding="UTF-8"?>
<!--
  Die Klammer um die beiden Projekte der Woche: den ServiceDesk, der ab
  Dienstagnachmittag Stueck fuer Stueck entsteht, und das fertige Lagersystem,
  das nebenher als Fremdsystem laeuft.

  Dieser Aggregator ist bequem, aber nicht noetig: beide Projekte haben eine
  eigene, vollstaendige pom.xml und bauen auch einzeln.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.netzfactor.schulung</groupId>
    <artifactId>jft-servicedesk</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Java fuer Fortgeschrittene: ServiceDesk</name>

    <modules>
        <module>servicedesk</module>
        <module>lagersystem</module>
    </modules>
</project>
